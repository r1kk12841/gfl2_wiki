    {
      "type": "paragraph",
      "html": "<b>Đội băng tương lai:</b> <b><a class=\"guide-inline-ref guide-inline-character\" title=\"Alva\" href=\"../characters/alva.html\" target=\"_blank\" rel=\"noopener\"><img class=\"guide-inline-icon\" src=\"../assets/images/characters/alva/avatar.png\" alt=\"Alva\" loading=\"lazy\">Alva</a>&nbsp; + <a class=\"guide-inline-ref guide-inline-character\" title=\"Soppo\" href=\"../characters/soppo.html\" target=\"_blank\" rel=\"noopener\"><img class=\"guide-inline-icon\" src=\"../assets/images/characters/soppo/avatar.png\" alt=\"Soppo\" loading=\"lazy\">Soppo</a>&nbsp; + <a class=\"guide-inline-ref guide-inline-character\" title=\"Eagletta\" href=\"../characters/eagletta.html\" target=\"_blank\" rel=\"noopener\"><img class=\"guide-inline-icon\" src=\"../assets/images/characters/eagletta/avatar.png\" alt=\"Eagletta\" loading=\"lazy\">Eagletta</a>&nbsp; +<a class=\"guide-inline-ref guide-inline-character\" title=\"Robella\" href=\"../characters/robella.html\" target=\"_blank\" rel=\"noopener\"><img class=\"guide-inline-icon\" src=\"../assets/images/characters/robella/avatar.png\" alt=\"Robella\" loading=\"lazy\">Robella</a>&nbsp;/<a class=\"guide-inline-ref guide-inline-character\" title=\"Asteria\" href=\"../characters/asteria.html\" target=\"_blank\" rel=\"noopener\"><img class=\"guide-inline-icon\" src=\"../assets/images/characters/asteria/avatar.png\" alt=\"Asteria\" loading=\"lazy\">Asteria</a>&nbsp; V6 + </b><a class=\"guide-inline-ref guide-inline-character\" title=\"OTs-14\" href=\"../characters/ots-14.html\" target=\"_blank\" rel=\"noopener\"><img class=\"guide-inline-icon\" src=\"../assets/images/characters/ots-14/avatar.png\" alt=\"OTs-14\" loading=\"lazy\">OTs-14</a>"
